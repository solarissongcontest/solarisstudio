{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "studio",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".output/server/index.mjs",
  "vars": {
    "NODE_ENV": "production",
    "SOLARIS_RUNTIME_ENV": "production",
    "MAINTENANCE_HOD_ACCESS": "true",
    "SUPABASE_URL": "https://dkxmnvekiopyesuzggeu.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_88TCCj0swFjn6xESWLwqlQ_HVUpU7Fa"
  },
  "assets": {
    "directory": ".output/public"
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  }
}
