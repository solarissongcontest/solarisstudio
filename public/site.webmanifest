{
  "name": "Solaris Studio",
  "short_name": "Solaris Studio",
  "description": "Solaris Studio is the home of Solaris Song Contest information, official rules, participation and published results.",
  "id": "/",
  "start_url": "/app-launch",
  "scope": "/",
  "display": "standalone",
  "background_color": "#020817",
  "theme_color": "#020817",
  "icons": [
    {
      "src": "/icon-192.png?v=img2340-20260929",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png?v=img2340-20260929",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable.svg?v=maskable-20260930",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "maskable"
    },
    {
      "src": "/icon-1024.png?v=img2340-20260929",
      "sizes": "1024x1024",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },
