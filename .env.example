# Copy to .env for local development. Never commit a real .env.
# These are public, browser-safe values only. No service-role key belongs in
# committed configuration.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxx"
VITE_SUPABASE_PROJECT_ID="your-project-ref"

# Server-side mirrors of the same public values (used during SSR)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxx"
SUPABASE_PROJECT_ID="your-project-ref"

# Televoting compatibility backend. URL/project ID are safe configuration.
# The service-role credential is SERVER-ONLY: configure the real value as the
# Cloudflare Worker secret TELEVOTING_SUPABASE_SERVICE_ROLE_KEY. The placeholder
# below is only for a private local .env and must never contain a real key in Git.
TELEVOTING_SUPABASE_URL="https://your-televoting-project.supabase.co"
TELEVOTING_SUPABASE_PROJECT_ID="your-televoting-project-ref"
TELEVOTING_SUPABASE_SERVICE_ROLE_KEY="your-local-server-only-secret"

# Browser-safe Televoting values used by public voting/results views.
TELEVOTING_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxx"
VITE_TELEVOTING_SUPABASE_URL="https://your-televoting-project.supabase.co"
VITE_TELEVOTING_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxx"
VITE_TELEVOTING_SUPABASE_PROJECT_ID="your-televoting-project-ref"
