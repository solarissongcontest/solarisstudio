# Copy to .env for local development. Never commit a real .env.
# Local development must use the isolated local Supabase stack. Run `supabase start`
# and obtain the local browser-safe key from `supabase status -o env`.
# Never paste hosted Solaris production values into a development .env.
VITE_SUPABASE_URL="http://127.0.0.1:54321"
VITE_SUPABASE_PUBLISHABLE_KEY="replace-with-local-publishable-key-from-supabase-status"
VITE_SUPABASE_PROJECT_ID="local"

# Server-side mirrors of the same LOCAL public values (used during SSR).
SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_PUBLISHABLE_KEY="replace-with-local-publishable-key-from-supabase-status"
SUPABASE_PROJECT_ID="local"

# Privileged local development operations may use the local Supabase service-role
# key reported by `supabase status -o env`. Never commit a real hosted service-role
# key. Production secrets belong only in the deployed server runtime.
SUPABASE_SERVICE_ROLE_KEY="replace-with-local-service-role-key-from-supabase-status"

# Televoting lives in the `televoting` schema of the Solaris Studio project and
# therefore needs no separate URL, project ID, publishable key, or service key.

# Temporary server-only bypass for emergency maintenance mode.
# Use a long random value and configure it as a Cloudflare Worker secret.
# Never expose it through a VITE_* variable or commit the real value.
MAINTENANCE_ADMIN_SECRET="replace-with-a-long-random-server-only-secret"

# Emergency HOD Confirmation portal switch. Fail-closed unless exactly `true`.
# This is intentionally independent from the global V3 launch and from the
# maintenance-admin bypass. Set it only in the deployed Worker runtime after the
# canonical Confirmation backend migration has reached production.
MAINTENANCE_HOD_ACCESS="false"

# Installed-app Web Push.
# The VAPID public key is browser-safe and must match WEB_PUSH_VAPID_PUBLIC_KEY
# configured for the Supabase Edge Function.
VITE_WEB_PUSH_PUBLIC_KEY="replace-with-vapid-public-key"

# Shared only between the Cloudflare cron trigger and the Solaris push Edge
# Function. Configure this as a Worker secret and Edge Function secret.
SOLARIS_PUSH_DISPATCH_SECRET="replace-with-a-long-random-dispatch-secret"

# Supabase Edge Function secrets. Never expose the private key through VITE_*.
WEB_PUSH_VAPID_PUBLIC_KEY="replace-with-vapid-public-key"
WEB_PUSH_VAPID_PRIVATE_KEY="replace-with-vapid-private-key"
WEB_PUSH_VAPID_SUBJECT="mailto:notifications@example.com"
