# Copy to .env for local development. Never commit a real .env.
# These are public, browser-safe values only. No service-role key belongs here.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxx"
VITE_SUPABASE_PROJECT_ID="your-project-ref"

# Server-side mirrors of the same public values (used during SSR)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxx"
SUPABASE_PROJECT_ID="your-project-ref"

# Televoting compatibility backend. These remain public project values; the
# legacy Televoting service-role credential must stay only inside its guarded
# server-side bridge runtime and must never be placed in Solaris Studio.
TELEVOTING_SUPABASE_URL="https://your-televoting-project.supabase.co"
TELEVOTING_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxx"
TELEVOTING_SUPABASE_PROJECT_ID="your-televoting-project-ref"
TELEVOTING_ADMIN_BRIDGE_URL="https://your-bridge.example/api/solaris-admin-proxy"

# Optional VITE_ mirrors are accepted for local compatibility where the same
# browser-safe Televoting project values already exist in a front-end env.
VITE_TELEVOTING_SUPABASE_URL="https://your-televoting-project.supabase.co"
VITE_TELEVOTING_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxx"
VITE_TELEVOTING_SUPABASE_PROJECT_ID="your-televoting-project-ref"
